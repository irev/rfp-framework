{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rfp:schemas:request-for-payment:create:v1",
  "title": "CreateRequestForPayment",
  "type": "object",
  "additionalProperties": false,
  "required": ["scenarioDefinitionId", "requestScope", "procurementContext", "paymentStructure", "businessPurpose", "money", "organizationContext", "payees"],
  "properties": {
    "scenarioDefinitionId": { "type": "string", "minLength": 1 },
    "requestScope": { "enum": ["INTERNAL", "EXTERNAL"] },
    "procurementContext": { "enum": ["PO_BASED", "CONTRACT_BASED", "NON_PO", "NO_PROCUREMENT"] },
    "paymentStructure": { "enum": ["SINGLE_PAYEE", "MULTI_PAYEE"] },
    "businessPurpose": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "money": {
      "type": "object",
      "additionalProperties": false,
      "required": ["amount", "currency"],
      "properties": {
        "amount": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$" },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }
      }
    },
    "organizationContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["legalEntityId"],
      "properties": {
        "legalEntityId": { "type": "string", "minLength": 1 },
        "businessUnitId": { "type": ["string", "null"] },
        "costCenterRef": { "type": ["string", "null"] }
      }
    },
    "payees": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["payeeType", "name"],
        "properties": {
          "payeeType": { "enum": ["VENDOR", "EMPLOYEE", "INDIVIDUAL", "GOVERNMENT", "ORGANIZATION", "OTHER"] },
          "vendorClassification": { "enum": ["REGISTERED_VENDOR", "ONE_TIME_VENDOR", null] },
          "masterReference": { "type": ["string", "null"] },
          "name": { "type": "string", "minLength": 1 }
        }
      }
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["relationType"],
        "properties": {
          "relationType": { "enum": ["SETTLEMENT_OF", "REFUND_OF", "REVERSAL_OF", "ADJUSTMENT_OF", "RELATED_TO"] },
          "requestId": { "type": ["string", "null"] },
          "externalReference": { "type": ["string", "null"] }
        }
      }
    }
  }
}
